rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || resource.data.parentId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || incoming().parentId == request.auth.uid);
      allow update: if isSignedIn() && (request.auth.uid == userId || existing().parentId == request.auth.uid);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Children link records
    match /children/{childId} {
      allow get: if isSignedIn() && (resource.data.parentId == request.auth.uid || resource.data.childUid == request.auth.uid || childId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && incoming().parentId == request.auth.uid;
      allow update: if isSignedIn() && (existing().parentId == request.auth.uid || existing().childUid == request.auth.uid);
      allow delete: if isSignedIn() && existing().parentId == request.auth.uid;
    }

    // Conversations
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (existing().childId == request.auth.uid || existing().parentId == request.auth.uid);
      allow delete: if isSignedIn() && (existing().childId == request.auth.uid || existing().parentId == request.auth.uid);

      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn();
      }
    }

    // Goals
    match /goals/{goalId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Safety Alerts
    match /safetyAlerts/{alertId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (existing().parentId == request.auth.uid || existing().childId == request.auth.uid);
      allow delete: if isSignedIn() && existing().parentId == request.auth.uid;
    }

    // Parent Insights
    match /parentInsights/{insightId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && existing().parentId == request.auth.uid;
    }
  }
}
